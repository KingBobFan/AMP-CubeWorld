#include "generic.kvp"

[Generic]
ApplicationName=Cube World Alpha (Modded)
Identifier=cubeworld-modded
Description=Modded Cube World Alpha Server using ServerModLauncher and Wine.
Executable=ServerModLauncher.exe
Arguments=
WineMode=True
WorkingDirectory=./
UpdateSourceType=URL
UpdateSourceURL=https://github.com/KingBobFan/AMP-CubeWorld/releases/download/CURRENT/cubeworld-server.zip
UpdateSourceExtract=True
AutoUpdate=True

[CustomPorts]
App.Ports=[{"Protocol":1,"Port":12345,"Offset":0,"Range":1,"Ref":"MainGamePort","Name":"Server Port","Description":"The UDP port the server will listen on.","IsDelayedOpen":false,"Hidden":false,"ChildPorts":null,"Required":true}]

[StandardSettings]
Category=Cube World Settings
Name=Server Port
Description=The UDP port the server will listen on.
Type=Integer
DefaultValue=12345
ConfigPath=server.cfg
