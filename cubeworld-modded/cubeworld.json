{
    "TemplateName": "Cube World Alpha (Modded)",
    "AppId": "cubeworld-modded",
    "AppConfigId": "cubeworld-modded",
    "ModuleType": "GenericModule",
    "Description": "Cube World Alpha Dedicated Server running via Wine with ServerModLauncher.",
    "Category": "Games",
    "SupportedPlatforms": ["Linux"],
    "Tags": ["Wine", "Classic", "Modded"],
    "Meta": {
        "DisplayName": "Cube World Alpha (Modded)",
        "Description": "Modded Cube World Alpha Server using ServerModLauncher and Wine.",
        "OS": "Linux",
        "Arch": "x86_64",
        "Author": "KingBobFan",
        "URL": "https://github.com/KingBobFan/AMP-CubeWorld",
        "MinAMPVersion": "2.5.0.8",
        "SpecificDockerImage": "cubecoders/ampbase:wine-stable",
        "DockerRequired": false,
        "ContainerPolicy": "SupportedOnWindows, RecommendedOnLinux"
    },
    "App": {
        "DisplayName": "Cube World Alpha (Modded)",
        "RootDir": "./cubeworld/",
        "BaseDirectory": "./cubeworld/",
        "ExecutableWin": "ServerModLauncher.exe",
        "ExecutableLinux": "/usr/bin/wine",
        "WorkingDir": "./",
        "LinuxCommandLineArgs": "ServerModLauncher.exe",
        "EnvironmentVariables": {
            "WINEPREFIX": "{{$FullRootDir}}.wine",
            "WINEARCH": "win64",
            "WINEDEBUG": "-all"
        },
        "ExitMethod": "OS_CLOSE",
        "ExitTimeout": 30,
        "HasWriteableConsole": true,
        "HasReadableConsole": true,
        "MaxUsers": 32,
        "PrimaryApplicationPortRef": "MainGamePort",
        "Ports": [
            {
                "Protocol": "UDP",
                "Port": 12345,
                "Ref": "MainGamePort",
                "Name": "Server Port",
                "Description": "The UDP port the server will listen on."
            }
        ],
        "UpdateSources": [
            {
                "UpdateStageName": "Cube World Server Download",
                "UpdateSourcePlatform": "All",
                "UpdateSource": "FetchURL",
                "UpdateSourceData": "https://github.com/KingBobFan/AMP-CubeWorld/releases/download/CURRENT/cubeworld-server.zip",
                "UpdateSourceTarget": "{{$FullRootDir}}",
                "OverwriteExistingFiles": true
            }
        ],
        "ApplicationReadyMode": "OS_START"
    }
}
