Meta.DisplayName=Cube World Alpha (Modded)
Meta.Description=Modded Cube World Alpha Server using ServerModLauncher and Wine.
Meta.OS=Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=KingBobFan
Meta.URL=https://github.com/KingBobFan/AMP-CubeWorld
Meta.DisplayImageSource=
Meta.ConfigRoot=cubeworld.kvp
Meta.MinAMPVersion=2.5.0.8
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.AppConfigId=cubeworld-modded
Meta.AppIsMultiIPAware=False

App.DisplayName=Cube World Alpha (Modded)
App.RootDir=./cubeworld/
App.BaseDirectory=./cubeworld/
App.ExecutableWin=ServerModLauncher.exe
App.ExecutableLinux=/usr/bin/wine
App.WorkingDir=./
App.LinuxCommandLineArgs="ServerModLauncher.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs=
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all"}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False

App.Ports=[{"Protocol":"UDP","Port":12345,"Ref":"MainGamePort","Name":"Server Port","Description":"The UDP port the server will listen on."}]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=MainGamePort
App.MaxUsers=32

App.UpdateSources=[{"UpdateStageName":"Cube World Server Download","UpdateSourcePlatform":"All","UpdateSource":"FetchURL","UpdateSourceData":"https://github.com/KingBobFan/AMP-CubeWorld/releases/download/CURRENT/cubeworld-server.zip","UpdateSourceTarget":"{{$FullRootDir}}","OverwriteExistingFiles":true}]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua"]
App.DumpFullChildProcessTree=False
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=OS_START
